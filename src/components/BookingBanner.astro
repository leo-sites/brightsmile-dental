---
import business from '../data/business.json';

const tel = (phone: string) => `tel:+1${phone.replace(/\D/g, '')}`;
---

<section id="book">
  <div class="wrapper banner">
    <div>
      <h2>Ready to book?</h2>
      <p>Call us or send an email and we will find a time that works for you.</p>
    </div>
    <div>
      <a class="cta" href={tel(business.phone)}>Call {business.phone}</a>
      <p class="emergency">
        Dental emergency after hours? <a href={tel(business.emergencyPhone)}>{business.emergencyPhone}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .banner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: center;
  }
  .emergency {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
